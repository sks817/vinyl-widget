<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 날씨 조회(Open-Meteo) -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 14+: 네트워크 조건이 있는 백그라운드 작업(30분 날씨 갱신)에 필수. 없으면 앱이 강제 종료됨 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 날씨용 대략적 위치. 백그라운드 위치·부팅 권한은 쓰지 않음 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 일정 메모지 위젯: 기기 캘린더 일정 읽기 (제목·시간만, 저장·전송 없음) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
        <!-- 스티커 위젯: 누르면 열 앱을 고르기 위해 홈 화면 아이콘이 있는 앱 목록을 봄 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigActivity"
            android:label="@string/config_title"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaListenerService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".WeatherJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".SpinWidgetProvider" android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_spin_info" />
        </receiver>

        <receiver android:name=".WeatherWidgetProvider" android:exported="true"
            android:label="@string/weather_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <receiver android:name=".SpinWideProvider" android:exported="true"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_spin_wide_info" />
        </receiver>

        <receiver android:name=".WeatherWideProvider" android:exported="true"
            android:label="@string/weather_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_wide_info" />
        </receiver>

        <activity
            android:name=".StickerConfigActivity"
            android:label="@string/sticker_label"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".StickerWidgetProvider" android:exported="true"
            android:label="@string/sticker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_sticker_info" />
        </receiver>

        <activity
            android:name=".TimetableConfigActivity"
            android:label="@string/tt_label"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".TimetableWidgetProvider" android:exported="true"
            android:label="@string/tt_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_timetable_info" />
        </receiver>

        <activity
            android:name=".WallpaperActivity"
            android:label="배경화면"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".PhotoConfigActivity"
            android:label="@string/photo_label"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".PhotoWidgetProvider" android:exported="true"
            android:label="@string/photo_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_photo_info" />
        </receiver>

        <receiver android:name=".MemoWidgetProvider" android:exported="true"
            android:label="@string/memo_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_memo_info" />
        </receiver>

        <service
            android:name=".MemoJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".WidgetActionReceiver" android:exported="false" />
    </application>
</manifest>

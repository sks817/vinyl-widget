<?xml version="1.0" encoding="utf-8"?>
<!-- 기본 4×1. 위젯을 늘리면 4×2(오늘·내일 목록), 세로로 길게 하면 2×4(일주일 목록)로 자동으로 바뀜.
     30분마다 + 캘린더가 바뀔 때마다 다시 그림 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp" android:minHeight="50dp"
    android:minResizeWidth="110dp" android:minResizeHeight="50dp"
    android:targetCellWidth="4" android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_memo"
    android:previewLayout="@layout/widget_memo"
    android:description="@string/memo_desc"
    android:configure="com.kwansik.vinylwidget.ConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />

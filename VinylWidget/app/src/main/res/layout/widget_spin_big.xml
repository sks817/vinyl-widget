<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 음악: [판+톤암 또는 카세트 크게] [곡 제목(두 줄까지) / 가수 / 이전·재생·다음].
     2×2를 옆으로 늘리거나 1×4를 아래로 늘리면 자동으로 이 배치 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg_image"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg_glass" android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <FrameLayout android:id="@+id/player_box"
            android:layout_width="170dp" android:layout_height="150dp">
            <FrameLayout android:id="@+id/deck"
                android:layout_width="170dp" android:layout_height="144dp" android:layout_gravity="center">
                <ImageView android:id="@+id/disc_body"
                    android:layout_width="144dp" android:layout_height="144dp" android:layout_gravity="start|center_vertical"
                    android:src="@drawable/vinyl_body" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/static_disc"
                    android:layout_width="144dp" android:layout_height="144dp" android:layout_gravity="start|center_vertical"
                    android:src="@drawable/vinyl_grooves" android:scaleType="fitCenter" />
                <ProgressBar android:id="@+id/spinner"
                    android:layout_width="144dp" android:layout_height="144dp" android:layout_gravity="start|center_vertical"
                    android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/vinyl_spin"
                    android:indeterminateDuration="1800" android:indeterminateBehavior="repeat"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:minWidth="0dp" android:minHeight="0dp" android:maxWidth="2000dp" android:maxHeight="2000dp"
                    android:visibility="gone" />
                <ProgressBar android:id="@+id/spinner_fun"
                    android:layout_width="144dp" android:layout_height="144dp" android:layout_gravity="start|center_vertical"
                    android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/vinyl_spin_fun"
                    android:indeterminateDuration="1800" android:indeterminateBehavior="repeat"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:minWidth="0dp" android:minHeight="0dp" android:maxWidth="2000dp" android:maxHeight="2000dp"
                    android:visibility="gone" />
                <ImageView android:id="@+id/label"
                    android:layout_width="144dp" android:layout_height="144dp" android:layout_gravity="start|center_vertical"
                    android:scaleType="fitCenter" />
                <CheckBox android:id="@+id/tonearm"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:button="@null" android:background="@drawable/tonearm_anim"
                    android:clickable="false" android:focusable="false" />
            </FrameLayout>
            <include layout="@layout/tape_part" />
        </FrameLayout>
        <LinearLayout android:id="@+id/w_text"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/m_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"
                android:lineSpacingMultiplier="1.05"
                android:textColor="@color/glass_text" android:text="음악을 재생해 주세요" />
            <TextView android:id="@+id/m_artist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="14sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="@color/glass_sub" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageButton android:id="@+id/btn_prev"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:src="@drawable/ic_prev_auto" android:scaleType="fitCenter" android:padding="9dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/prev" />
                <FrameLayout android:id="@+id/play_box"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_marginStart="6dp" android:layout_marginEnd="6dp">
                    <ImageView android:id="@+id/play_bg"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/play_circle_auto" />
                    <ImageButton android:id="@+id/btn_play"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/ic_play_on" android:scaleType="fitCenter" android:padding="14dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/play" />
                </FrameLayout>
                <ImageButton android:id="@+id/btn_next"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:src="@drawable/ic_next_auto" android:scaleType="fitCenter" android:padding="9dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 1×4 레코드: [판+톤암] [곡 제목/가수] [이전·재생·다음] -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg_image"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg_glass" android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <FrameLayout android:id="@+id/deck"
            android:layout_width="70dp" android:layout_height="60dp">
            <ImageView android:id="@+id/static_disc"
                android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="start|center_vertical"
                android:src="@drawable/vinyl_disc" android:scaleType="fitCenter" />
            <ProgressBar android:id="@+id/spinner"
                android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="start|center_vertical"
                android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/vinyl_spin"
                android:indeterminateDuration="1800" android:indeterminateBehavior="repeat"
                android:interpolator="@android:anim/linear_interpolator"
                android:minWidth="0dp" android:minHeight="0dp" android:maxWidth="2000dp" android:maxHeight="2000dp"
                android:visibility="gone" />
            <ImageView android:id="@+id/label"
                android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="start|center_vertical"
                android:scaleType="fitCenter" />
            <CheckBox android:id="@+id/tonearm"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:button="@null" android:background="@drawable/tonearm_anim"
                android:clickable="false" android:focusable="false" />
        </FrameLayout>
        <LinearLayout android:id="@+id/w_text"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/m_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                android:textColor="@color/glass_text" android:text="음악을 재생해 주세요" />
            <TextView android:id="@+id/m_artist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                android:textColor="@color/glass_sub" />
        </LinearLayout>
        <ImageButton android:id="@+id/btn_prev"
            android:layout_width="38dp" android:layout_height="44dp"
            android:src="@drawable/ic_prev_auto" android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/prev" />
        <ImageButton android:id="@+id/btn_play"
            android:layout_width="38dp" android:layout_height="44dp"
            android:src="@drawable/ic_play_auto" android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/play" />
        <ImageButton android:id="@+id/btn_next"
            android:layout_width="38dp" android:layout_height="44dp"
            android:src="@drawable/ic_next_auto" android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/next" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/bg_image"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg_glass" android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical">
        <TextClock android:id="@+id/w_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="M.d" android:format24Hour="M.d"
            android:fontFamily="serif" android:textStyle="bold" android:textSize="44sp"
            android:letterSpacing="-0.03" android:includeFontPadding="false"
            android:textColor="@color/glass_text" />
        <TextClock android:id="@+id/w_day"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE" android:format24Hour="EEEE"
            android:textSize="14sp" android:textColor="@color/glass_text" />
        <ImageView android:id="@+id/w_divider"
            android:layout_width="110dp" android:layout_height="1dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
            android:src="@drawable/line_1dp" android:scaleType="fitXY" android:alpha="0.4" />
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_icon"
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_w_sun" android:tint="@color/glass_accent" />
            <TextView android:id="@+id/w_temp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--°"
                android:fontFamily="serif" android:textSize="24sp" android:textColor="@color/glass_text" />
        </LinearLayout>
        <TextView android:id="@+id/w_cond"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/glass_text" />
    </LinearLayout>
</FrameLayout>

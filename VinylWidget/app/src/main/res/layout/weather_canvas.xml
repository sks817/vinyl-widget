<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/bg_image"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" />
    <ImageView android:id="@+id/w_canvas"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout android:id="@+id/w_tap_calendar"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <FrameLayout android:id="@+id/w_tap_refresh"
            android:layout_width="match_parent" android:layout_height="44dp" />
    </LinearLayout>
</FrameLayout>
